# ══════════════════════════════════════════════════════════════════════════════
#  SAP Sales Cloud V2 MCP Server — Credentials
#
#  HOW TO USE
#  ──────────────────────────────────────────────────────────────────────────
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the two values below.
#  3. That's it.  Never put credentials in any other file.
#
#  .env is gitignored and stays on your machine only.
#  .mcp.json (already committed) registers the server with Claude Code
#    automatically — no credentials go there.
#  Claude Desktop users add only the path to claude_desktop_config.json
#    (see mcp.json → claude_desktop_snippet) — no credentials go there either.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of your SAP Sales Cloud V2 tenant.
# Sandbox: https://sandbox.api.sap.com
# Real tenant: https://my123456.crm.cloud.sap
SALES_CLOUD_BASE_URL=https://sandbox.api.sap.com

# API key for authentication.
# Obtain from: Settings > API Keys in your Sales Cloud V2 tenant.
SALES_CLOUD_API_KEY=your-api-key-here

# ── Optional overrides (safe defaults shown) ──────────────────────────────────

# HTTP header name used to send the API key (default: APIKey)
# SALES_CLOUD_API_KEY_HEADER=APIKey

# OData service base path relative to SALES_CLOUD_BASE_URL
# ODATA_BASE_PATH=/sap/c4c/odata/v1/c4codataapi

# HTTP request timeout in milliseconds
# REQUEST_TIMEOUT_MS=30000

# Max retry attempts for transient errors
# MAX_RETRIES=3

# ── SAP BTP Cloud Foundry deployment (future) ─────────────────────────────────
# Uncomment when deploying the server to BTP.  When all four values are set,
# the server switches from API Key to OAuth2 client_credentials flow.

# BTP_APP_URL=https://sales-cloud-mcp.cfapps.eu10.hana.ondemand.com
# BTP_CLIENT_ID=sb-sales-cloud-mcp!t12345
# BTP_CLIENT_SECRET=your-btp-client-secret
# BTP_TOKEN_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com/oauth/token
